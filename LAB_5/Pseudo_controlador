% =========================================================================
% SIMULACIÓN EN LAZO CERRADO: SBPA CON CONTROLADOR (DARK THEME)
% =========================================================================

% 1. Extraer la señal SBPA del workspace
ruido_sbpa = out.senal(:); 

% 2. Definición de Planta y Controlador
s = tf('s');
G = 0.673 / (0.6*s + 1);
K = 10; % Ganancia ajustable

% --- SELECCIÓN DE CONTROLADOR ---
C_controlador = K * (0.6*s + 1) / (6*s + 1);      % ATRASO (Lag)
%C_controlador = K * (0.6*s + 1) / (0.06*s + 1); % ADELANTO (Lead)

% Sistema en lazo cerrado: C(s)G(s) / (1 + C(s)G(s))
sys_lazo_cerrado = feedback(C_controlador * G, 1);

% 3. Parámetros de Tiempo
Ts = 0.001; 
t_final = 5; 
t = (0:Ts:t_final)'; 
N = length(t);

% 4. Construcción de la Señal de Referencia (Escalón + SBPA)
r_total = zeros(N, 1); 

t_escalon = 0.5;
t_estacionario = t_escalon + 3.0; 
idx_escalon = find(t >= t_escalon, 1);
idx_ruido = find(t >= t_estacionario, 1);

% A. Aplicar el escalón base de 5.5V
r_total(idx_escalon:end) = 5.5;

% B. Preparar y extender el ruido SBPA
largo_ruido_necesario = N - idx_ruido + 1;
ruido_extendido = repmat(ruido_sbpa, ceil(largo_ruido_necesario / length(ruido_sbpa)), 1);
ruido_extendido = ruido_extendido(1:largo_ruido_necesario); 

% C. Convertir a señal bipolar y escalar al 10%
ruido_bipolar = 2 * (ruido_extendido - 0.5);
amplitud_ruido = 5.5 * 0.10; 

% Sumar la perturbación al escalón de referencia
r_total(idx_ruido:end) = r_total(idx_ruido:end) + (ruido_bipolar * amplitud_ruido);

% 5. Simulación del Sistema en Lazo Cerrado
y_salida = lsim(sys_lazo_cerrado, r_total, t);

% =========================================================================
% 6. Visualización de Resultados (DARK THEME)
% =========================================================================
colorFondo = [0.15 0.15 0.15]; 
colorEjes = 'w';

fig = figure('Name', 'Lazo Cerrado con SBPA', 'Color', colorFondo, 'Position', [100, 100, 800, 600]);

% Gráfica de la Referencia
ax1 = subplot(2,1,1);
plot(t, r_total, 'Color', '#00FFFF', 'LineWidth', 1.2); % Cian
hold on; 
plot([0, t(end)], [5.5, 5.5], 'w--', 'LineWidth', 1.5);
set(ax1, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes); 
title('\textbf{Referencia: Escalón + SBPA ($r_t$)}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 14);
xlabel('Tiempo [s]', 'Interpreter', 'latex', 'Color', 'w');
ylabel('Amplitud [V]', 'Interpreter', 'latex', 'Color', 'w');
grid on;
legend('Referencia Total', 'Referencia 5.5V', 'Interpreter', 'latex', 'Location', 'northwest', 'TextColor', 'w', 'Color', [0.2 0.2 0.2], 'EdgeColor', 'w');
xlim([0 t(end)]);
ylim([-0.5 6.5]); 

% Gráfica de la Salida de la Planta
ax2 = subplot(2,1,2);
plot(t, y_salida, 'Color', '#FF5555', 'LineWidth', 1.5); % Rojo claro
hold on;
plot([0, t(end)], [5.5, 5.5], 'w--', 'LineWidth', 1.5); % En lazo cerrado, esperamos que llegue a 5.5V
set(ax2, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes); 
title('\textbf{Respuesta del Sistema Controlado ($y_t$)}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 14);
xlabel('Tiempo [s]', 'Interpreter', 'latex', 'Color', 'w');
ylabel('Amplitud [V]', 'Interpreter', 'latex', 'Color', 'w');
grid on;
legend('Salida de la Planta', 'Referencia Deseada', 'Interpreter', 'latex', 'Location', 'southeast', 'TextColor', 'w', 'Color', [0.2 0.2 0.2], 'EdgeColor', 'w');
xlim([0 t(end)]);
