% =========================================================================
% ANÁLISIS Y SIMULACIÓN DE SEÑAL PWM ALEATORIA (DARK THEME)
% =========================================================================

% 1. Parámetros de Tiempo
Ts = 0.001; 
t_final = 5; 
t = (0:Ts:t_final)'; 
N = length(t);

% 2. Generación del PWM con Ancho de Pulso Aleatorio
f_pwm = 10; % Frecuencia base del PWM (10 Hz)
T_pwm = 1/f_pwm; % Periodo del PWM

% Crear un vector de ciclos de trabajo (duty cycles) aleatorios para cada periodo
num_periodos = ceil(t_final / T_pwm);
% rand() genera valores entre 0 y 1. Los limitamos entre 0.1 (10%) y 0.9 (90%)
duty_aleatorio = 0.1 + 0.8 * rand(num_periodos, 1); 

% Mapear el tiempo actual para saber en qué periodo del PWM estamos
indices_periodo = floor(t / T_pwm) + 1;
% Evitar que el último instante pida el periodo 51 (que no existe)
indices_periodo = min(indices_periodo, num_periodos); 
senal_duty = duty_aleatorio(indices_periodo); % Señal escalonada con el duty actual

% Generar una señal portadora "diente de sierra" entre 0 y 1
portadora = (sawtooth(2*pi*f_pwm*t) + 1) / 2;

% Generar el PWM: es 1 cuando la portadora es menor que el Duty Cycle
pwm_unipolar = double(portadora < senal_duty);

% Convertir a bipolar (-1 a 1) para cumplir la regla del +/- 10%
pwm_bipolar = 2 * (pwm_unipolar - 0.5);

% =========================================================================
% PARTE A: ANÁLISIS DE LA SEÑAL PWM (Punto 3 de la guía)
% =========================================================================
colorFondo = [0.15 0.15 0.15]; colorEjes = 'w';
fig1 = figure('Name', 'Análisis de Señal PWM Aleatoria', 'Color', colorFondo, 'Position', [100, 100, 800, 900]);

% 1. Auto-correlación
[rxx_pwm, lags] = xcorr(pwm_bipolar, 'biased'); 
tiempo_lags = lags * Ts;
ax1 = subplot(3,1,1);
plot(tiempo_lags, rxx_pwm, 'Color', '#00FFFF', 'LineWidth', 1.5);
set(ax1, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes);
title('\textbf{Auto-correlación del PWM Aleatorio}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 12);
xlabel('Rezagos (Lag) [s]', 'Interpreter', 'latex', 'Color', 'w');
ylabel('$R_{xx}(\tau)$', 'Interpreter', 'latex', 'Color', 'w');
grid on;

% 2. Convolución Discreta
c_pwm = conv(pwm_bipolar, pwm_bipolar);
n_conv = (0:length(c_pwm)-1) * Ts; 
ax2 = subplot(3,1,2);
plot(n_conv, c_pwm, 'Color', '#FF5555', 'LineWidth', 1.5);
set(ax2, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes);
title('\textbf{Convolución Discreta}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 12);
xlabel('Tiempo [s]', 'Interpreter', 'latex', 'Color', 'w');
ylabel('Amplitud', 'Interpreter', 'latex', 'Color', 'w');
grid on;

% 3. FFT
Y_pwm = fft(pwm_bipolar);
P2_pwm = abs(Y_pwm/N);
P1_pwm = P2_pwm(1:floor(N/2)+1);
P1_pwm(2:end-1) = 2*P1_pwm(2:end-1);
f_vec = (1/Ts)*(0:(floor(N/2)))/N; 
ax3 = subplot(3,1,3);
plot(f_vec, P1_pwm, 'Color', '#55FF55', 'LineWidth', 1.5);
set(ax3, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes);
title('\textbf{Espectro de Magnitud (FFT)}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 12);
xlabel('Frecuencia ($f$) [Hz]', 'Interpreter', 'latex', 'Color', 'w');
ylabel('$|P_1(f)|$', 'Interpreter', 'latex', 'Color', 'w');
xlim([0 100]); % Zoom hasta 100 Hz para ver los armónicos del PWM
grid on;

% =========================================================================
% PARTE B: INYECCIÓN A LA PLANTA (Punto 4 de la guía)
% =========================================================================
% Reconstrucción de la señal de entrada
u_total = zeros(N, 1);
t_escalon = 0.5;
t_estacionario = t_escalon + 3.0; 
idx_escalon = find(t >= t_escalon, 1);
idx_ruido = find(t >= t_estacionario, 1);

u_total(idx_escalon:end) = 5.5; % Escalón base

% Adecuar el PWM (Amplitud del 10% de 5.5V = 0.55V)
amplitud_ruido = 5.5 * 0.10; 
% Se inyecta el PWM solo a partir del estado estacionario
u_total(idx_ruido:end) = u_total(idx_ruido:end) + (pwm_bipolar(idx_ruido:end) * amplitud_ruido);

% Simulación de la Planta
s = tf('s');
G = 0.673 / (0.6*s + 1);
y_salida = lsim(G, u_total, t);

% Gráficas de Simulación
fig2 = figure('Name', 'Respuesta con PWM Aleatorio', 'Color', colorFondo, 'Position', [150, 150, 800, 600]);

% Entrada
ax4 = subplot(2,1,1);
plot(t, u_total, 'Color', '#00FFFF', 'LineWidth', 1.2);
hold on; plot([0, t(end)], [5.5, 5.5], 'w--', 'LineWidth', 1.5);
set(ax4, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes); 
title('\textbf{Entrada: Escalón + PWM Aleatorio ($u_t$)}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 14);
xlabel('Tiempo [s]', 'Interpreter', 'latex', 'Color', 'w'); ylabel('Amplitud [V]', 'Interpreter', 'latex', 'Color', 'w');
grid on; xlim([0 t(end)]); ylim([-0.5 6.5]);

% Salida
ax5 = subplot(2,1,2);
plot(t, y_salida, 'Color', '#FF5555', 'LineWidth', 1.5);
hold on; plot([0, t(end)], [5.5*0.673, 5.5*0.673], 'w--', 'LineWidth', 1.5);
set(ax5, 'Color', colorFondo, 'XColor', colorEjes, 'YColor', colorEjes, 'GridColor', colorEjes); 
title('\textbf{Respuesta de la Planta ($y_t$)}', 'Interpreter', 'latex', 'Color', 'w', 'FontSize', 14);
xlabel('Tiempo [s]', 'Interpreter', 'latex', 'Color', 'w'); ylabel('Amplitud [V]', 'Interpreter', 'latex', 'Color', 'w');
grid on; xlim([0 t(end)]);
